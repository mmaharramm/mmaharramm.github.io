.env
.env.*
*.pem
*.key
*.p12
*.ovpn
id_rsa*
*.kdbx

# Raw engagement / lab material that should not be published
loot/
scans/
*.pcap
*.pcapng

# OS / IDE
.DS_Store
.vscode/
